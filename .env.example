EPADD_BIND_ADDRESS=127.0.0.1
EPADD_PORT=8080
EPADD_MODE=appraisal
EPADD_LANGUAGE=en
EPADD_ADMIN_CONTACT=
EPADD_JAVA_OPTS=-Xmx4g
EPADD_MEM_LIMIT=6g

# Only used with docker-compose.auth.yml
EPADD_DOMAIN=epadd.example.org
OIDC_ISSUER_URL=https://idp.example.org/realms/main
OIDC_CLIENT_ID=epadd
OIDC_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
# Who may log in: a domain, a file of emails (one per line), or both.
# With neither set nobody is admitted.
OAUTH2_EMAIL_DOMAINS=
#OAUTH2_ALLOWED_EMAILS_FILE=./docker/auth/allowed-emails.txt
OAUTH2_UPSTREAM_TIMEOUT=3600s
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
